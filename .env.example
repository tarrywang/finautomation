# Copy to .env and customize. .env is git-ignored.
# Used by compose.yml and the Python ETL/web layer.

# ───────────── Postgres (Docker) ─────────────
# 端口 5433 而不是 5432,避免和系统里已经在跑的其他 postgres 冲突
PG_PASSWORD=fapiao_dev_only_change_me
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=fapiao
PG_USER=fapiao

# Computed (don't override unless you know what you're doing):
# DATABASE_URL=postgresql+psycopg://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DB}

# ───────────── 发票通 (Invoice API) ─────────────
FAPIAO_CLIENT_ID=JSFpcLPrvr
FAPIAO_CLIENT_SECRET=0ccddec66317466098b3144922de2e0e

# ───────────── Web ─────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ───────────── Web Auth ─────────────
# Generate fresh: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_me_with_64_hex_chars
WEB_PASSWORD=set_a_strong_password_here
