# /etc/systemd/system/fapiao-sync-daily.service
[Unit]
Description=发票通 daily sync (14-day rolling)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=vmuser
Group=vmuser
WorkingDirectory=/home/vmuser/finautomation
ExecStart=/usr/bin/docker compose -f compose.prod.yml exec -T app python scripts/sync_daily.py --days 14
# Log to journald (see: journalctl -u fapiao-sync-daily.service)
StandardOutput=journal
StandardError=journal
