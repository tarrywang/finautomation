# Copy to .env and fill in. Secrets come from macOS Keychain by default (see config.py).
# .env is git-ignored.

# Anthropic key — Keychain preferred:
#   security add-generic-password -s tax_auto -a anthropic_api_key -w 'sk-ant-...'
# ANTHROPIC_API_KEY=sk-ant-...

# ───────────── Email notification (SMTP) ─────────────
# SMTP password lives in Keychain:
#   security add-generic-password -s tax_auto -a smtp_password -w '...'
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=tarryesc@qq.com
SMTP_USE_SSL=true

# Where alerts go
NOTIFY_FROM=tarryesc@qq.com
NOTIFY_TO=tarryesc@gmail.com

# Cap email volume (avoid storm during prod incident)
NOTIFY_RATE_LIMIT_PER_HOUR=20

# 时区
TZ=Asia/Shanghai

# 日志
LOG_LEVEL=INFO

# Runtime path override — leave default
# RUNTIME_DIR=./runtime
